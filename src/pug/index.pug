doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description' content='')
        meta(name='author' content='')

        title Home

        // Favicon
        link(rel='icon' type='image/x-icon' href='assets/favicon.ico')

        script(src="js/scripts.js")

        include includes/css.pug

    body.d-flex.flex-column.h-100
        // Loader
        #loader(style='position: fixed; inset: 0; background: white; z-index: 9999; display: flex; align-items: center; justify-content: center;')
            .loader

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Header
            header.py-5
                .container.px-5.pb-5
                    .row.gx-5.align-items-center
                        .col-xxl-5
                            // Header text content
                            .text-center.text-xxl-start
                                .badge.bg-gradient-primary-to-secondary.text-white.mb-4
                                    .text .Net Core &middot; C# &middot; Angular &middot; Azure
                                .fs-3.fw-light.text-muted Empowering your business
                                h1.display-3.fw-bolder.mb-5
                                    span.text-gradient.d-inline Through meaningful code.
                                .d-grid.gap-3.d-sm-flex.justify-content-sm-center.justify-content-xxl-start.mb-3
                                    a.btn.btn-primary.btn-lg.px-5.py-3.me-sm-3.fs-6.fw-bolder(href='resume.html') Resume
                                    a.btn.btn-outline-dark.btn-lg.px-5.py-3.fs-6.fw-bolder(href='portfolio.html') Portfolio
                        .col-xxl-7
                            // Header profile picture
                            .d-flex.justify-content-center.mt-5.mt-xxl-0
                                .profile.bg-gradient-primary-to-secondary
                                    img#profile-img.profile-img(src='assets/cv_main.png' alt='...')
                                    .dots-1
                                        include includes/svg-dots.pug
                                    .dots-2
                                        include includes/svg-dots.pug
                                    .dots-3
                                        include includes/svg-dots.pug
                                    .dots-4
                                        include includes/svg-dots.pug

            // About Section
            section.bg-light.py-5
                .container.px-5
                    .row.gx-5.justify-content-center
                        .col-xxl-8
                            .text-center.my-5
                                h2.display-5.fw-bolder
                                    span.text-gradient.d-inline About Me
                                p.lead.fw-light.mb-4 I’m a passionate and purpose-driven software developer. Guided by my Christian faith, I bring integrity, diligence, and a commitment to excellence into every project I take on. I specialize in building clean, efficient, and meaningful software solutions, always with an eye toward long-term impact. I value open collaboration, diverse perspectives, and mentoring others, and I’m continually learning to stay ahead in a fast-changing field. Whether working with startups, businesses, or non-profits, my goal is to deliver software that makes life better—for teams, users, and communities.

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
