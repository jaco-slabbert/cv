doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Portfolio

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100.bg-light
        // Loader
        #loader(style='position: fixed; inset: 0; background: white; z-index: 9999; display: flex; align-items: center; justify-content: center;')
            .loader
        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Portfolio Section
            section.py-5
                .container.px-5.mb-5
                    .text-center.mb-5
                        h1.display-5.fw-bolder.mb-0
                            span.text-gradient.d-inline Portfolio
                    .row.gx-5.justify-content-center

                        .col-lg-11.col-xl-9.col-xxl-8

                            // Project Card 1
                            .card.overflow-hidden.shadow.rounded-4.border-0.mb-5
                                .card-body.p-0
                                    .d-flex.align-items-center.place-content-space-between
                                        .p-5
                                            h2.fw-bolder Betway
                                            p I worked on high-traffic betting components within the Betway platform, contributing to stability, performance, and real-time engagement at scale.
                                            a.text-gradient(href='https://betway.co.za') Check it out
                                        img.img-fluid(style='height: 100%; max-width: 300px' src='assets/betway.png', alt='...')

                            // Project Card 2
                            .card.overflow-hidden.shadow.rounded-4.border-0.mb-5
                                .card-body.p-0
                                    .d-flex.align-items-center.place-content-space-between
                                        .p-5
                                            h2.fw-bolder Intigriti
                                            p I helped integrate secure bug bounty workflows into the Intigriti platform, enabling responsible disclosure, triage, and rewards.
                                            a.text-gradient(href='https://intigriti.com/') Check it out
                                        img.img-fluid(style='max-height: 400px; max-width: 300px' src='assets/intigriti.png', alt='...')

                            // Project Card 3
                            .card.overflow-hidden.shadow.rounded-4.border-0.mb-5
                                .card-body.p-0
                                    .d-flex.align-items-center.place-content-space-between
                                        .p-5
                                            h2.fw-bolder Korridor
                                            p Built key web tools for this international logistics platform, streamlining freight coordination, planning, trip costs, and reducing cross-border operational friction.
                                            a.text-gradient(href='https://korridor.com/') Check it out
                                        img.img-fluid(style='max-height: 400px; max-width: 300px' src='assets/korridor.png', alt='...')

