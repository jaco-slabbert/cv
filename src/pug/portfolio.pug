                                            a.text-gradient(href='https://fusiontree.co.za') Check it out
                                        img.img-fluid(style='max-height: 400px; max-width: 300px' src='assets/ftreescreenshot.png', alt='...')

                            // Project Card 7
                            .card.overflow-hidden.shadow.rounded-4.border-0.mb-5
                                .card-body.p-0
                                    .d-flex.align-items-center.place-content-space-between
                                        .p-5
                                            h2.fw-bolder Bank Statement 2 Excel
                                            p This SaaS tool helps accountants convert PDF bank statements to importable CSV files, saving the users countless hours of manual input. During my involvement, subscription profits tripled. 
                                            a.text-gradient(href='https://www.bankstatements2excel.co.za/') Check it out
                                        img.img-fluid(style='max-height: 400px; max-width: 300px' src='assets/pdfconverter.png', alt='...')

